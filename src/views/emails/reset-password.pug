extends base-email

block content
  table(align="center" )
    tr
      td(style="padding: 30px;")
        h2(style="color: #000; margin-top: 0;") Thanks for Reaching Out
        p Hi #{name},
        p Thank you for getting in touch with us. We've received your message and a member of our team will respond within 3 business days.
        p Whether it’s a question, suggestion, collaboration idea, or concern—we’re here, and we’re listening.
        p In the meantime, feel free to:
        ul(style="padding-left: 20px; line-height: 1.6;")
          li
            | Connect with us on social media:
            a(href="https://facebook.com") Facebook
            |  |
            a(href="https://instagram.com") Instagram
            |  |
            a(href="https://linkedin.com") LinkedIn
            |  |
            a(href="https://x.com") X
          li
            | Explore our online store →
            a(href="#") [Insert link]
          li
            | Read the latest from eLab from
            a(href="#") here

        p Thank you again for reaching out.
          br
          | We see you. We appreciate you.

        p
          strong The Ennovate Lab Team
          br
          | We transform underserved communities through technology, entrepreneurship & placemaking.

        p
          | Explore our work:
          a(href="https://www.ennovatelab.com") www.ennovatelab.com
