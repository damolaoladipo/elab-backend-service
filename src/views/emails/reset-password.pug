block content
  table(align="center" style="background-color: #fff; text-align: left; border-radius: 8px; width: 600px; margin: 0 auto; padding: 0; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);")
    tr
      td(style="background-color: #000; text-align: center; padding: 20px;")
        img(src="https://www.ennovatelab.com/assets/img/logo.svg" alt="ennovate logo" style="height: 40px;")

    tr
      td(style="padding: 30px;")
        h2(style="color: #000; margin-top: 0;") Thanks for Reaching Out
        p Hi #{name},
        p Thank you for getting in touch with us. We've received your message and a member of our team will respond within 3 business days.
        p Whether it’s a question, suggestion, collaboration idea, or concern—we’re here, and we’re listening.
        p In the meantime, feel free to:
        ul(style="padding-left: 20px; line-height: 1.6;")
          li
            | Connect with us on social media:
            a(href="https://facebook.com") Facebook
            |  |
            a(href="https://instagram.com") Instagram
            |  |
            a(href="https://linkedin.com") LinkedIn
            |  |
            a(href="https://x.com") X
          li
            | Explore our online store →
            a(href="#") [Insert link]
          li
            | Read the latest from eLab from
            a(href="#") here

        p Thank you again for reaching out.
          br
          | We see you. We appreciate you.

        p
          strong The Ennovate Lab Team
          br
          | We transform underserved communities through technology, entrepreneurship & placemaking.

        p
          | Explore our work:
          a(href="https://www.ennovatelab.com") www.ennovatelab.com

    tr
      td(style="background-color: #000; padding: 20px 30px; text-align: center; color: #fff;")
        a(href="#" style="margin: 0 8px;")
          img(src="https://cdn-icons-png.flaticon.com/512/174/174857.png" alt="LinkedIn" style="height: 24px; width: 24px;")
        a(href="#" style="margin: 0 8px;")
          img(src="https://cdn-icons-png.flaticon.com/512/733/733547.png" alt="Facebook" style="height: 24px; width: 24px;")
        a(href="#" style="margin: 0 8px;")
          img(src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" alt="Instagram" style="height: 24px; width: 24px;")
        a(href="#" style="margin: 0 8px;")
          img(src="https://cdn-icons-png.flaticon.com/512/3670/3670151.png" alt="X" style="height: 24px; width: 24px;")
        a(href="#" style="margin: 0 8px;")
          img(src="https://cdn-icons-png.flaticon.com/512/733/733585.png" alt="Email" style="height: 24px; width: 24px;")
        a(href="#" style="margin: 0 8px;")
          img(src="https://cdn-icons-png.flaticon.com/512/733/733585.png" alt="WhatsApp" style="height: 24px; width: 24px;")

        p(style="margin-top: 15px; font-size: 12px;")
          | Copyright © 2025 Ennovate Lab
