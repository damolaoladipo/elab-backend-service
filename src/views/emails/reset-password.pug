extends base-email

block content
  table(align="center" style="background-color: #fff; text-align: center; border-radius: 0 0 20px 20px; width: 600px; margin: 0 auto; padding: 0 30px;")
    tr
      td(style="font-weight: 600; font-size: 1.2rem; color: #404040; padding-top: 20px; padding-bottom: 20px; border-bottom: 1px solid #e6e6e6;")
        | Your Password Has Been Changed

    tr
      td(style="text-align: left; font-weight: 600; font-size: 1.2rem; color: #404040; padding-top: 30px; padding-bottom: 10px;")
        | Hello #{name},

    tr
      td(style="text-align: left; font-size: 1rem; color: #505356; padding: 0 0 20px;")
        p(style="margin: 0 0 15px;")
          | We’re letting you know that your password was changed successfully.
        p(style="margin: 0 0 15px;")
          | If you didn’t do this, please secure your account immediately.

    tr
      td(style="text-align: center; padding: 30px 0;")
        a(href=supportLink style="padding: 12px 24px; background-color: #d72638; color: #fff; font-weight: bold; text-decoration: none; border-radius: 5px; display: inline-block;")
          | Contact Support

    tr
      td(style="text-align: left; font-size: 1rem; padding-top: 40px;")
        | Stay safe,
        br
        | The Ennovate Lab Team.
