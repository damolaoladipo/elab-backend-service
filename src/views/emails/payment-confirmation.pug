extends base-email

block content 
    table(align="center" style="background-color: #fff; text-align: center; border-radius: 0 0 20px 20px; width: 600px; margin: 0px auto 0px; padding: 0px 30px; ")
        tr
            td(style="font-weight: 600; font-size: 1.2rem; color: #404040; padding-top: 0px; padding-bottom: 20px; border-bottom: 1px solid #e6e6e6; ")
                | Your payment for #{item} is Confirmed

        // HEADER SECTION ENDS

        tr
            td(style="text-align: left; font-weight: 600; font-size: 1.2rem; color: #404040; padding-top: 30px; padding-bottom: 5px; ")
                | Hello #{name},

        tr(style="text-align: left; color: #505356")
            td(style="padding: 0 0px")
                p(style="margin: 10px auto 15px; font-size: 1rem; text-align: left; ")
                    | Great news — your payment has been confirmed!

                p(style="margin: 10px auto 25px; font-size: 1rem; text-align: left; ")
                    | Here are the details of your purchase:

        tr(style="text-align: left; color: #505356")
            td(style="padding: 10px 0px")
                p(style="margin: 5px 0px; font-size: 1rem")
                    strong Description: 
                    | #{desc}
                p(style="margin: 5px 0px; font-size: 1rem")
                    strong Date: 
                    | #{date}
                p(style="margin: 5px 0px; font-size: 1rem")
                    strong Total Paid: 

        tr(style="text-align: left; color: #505356")
            td(style="padding: 15px 0px 10px")
                p(style="margin: 0px auto 20px; font-size: 1rem; text-align: left; ")
                    | From bold ideas to perfect execution—this space is designed just for YOU.
                p(style="margin: 0px auto 30px; font-size: 1rem; text-align: left; ")
                    | We look forward to seeing you again.
                p(style="margin: 10px auto 20px; font-size: 1rem")
                    | Warm Regards,
                    br           
                    | The Ennovate Lab Team.
