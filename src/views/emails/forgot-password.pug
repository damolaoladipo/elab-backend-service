extends base-email

block content
  table(align="center" style="background-color: #fff; text-align: center; border-radius: 0 0 20px 20px; width: 600px; margin: 0 auto; padding: 0 30px;")
    tr
      td(style="font-weight: 600; font-size: 1.2rem; color: #404040; padding-top: 20px; padding-bottom: 20px; border-bottom: 1px solid #e6e6e6;")
        | Reset Your Password

    tr
      td(style="text-align: left; font-weight: 600; font-size: 1.2rem; color: #404040; padding-top: 30px; padding-bottom: 10px;")
        | Hello #{name},

    tr
      td(style="text-align: left; font-size: 1rem; color: #505356; padding: 0 0 20px;")
        p(style="margin: 0 0 15px;")
          | We received a request to reset your password.
        p(style="margin: 0 0 15px;")
          | This link is valid for #{expiry}. If you didn’t request this, you can ignore this email.

    tr
      td(style="text-align: center; padding: 30px 0;")
        a(href=resetLink style="padding: 12px 24px; background-color: #0052cc; color: #fff; font-weight: bold; text-decoration: none; border-radius: 5px; display: inline-block;")
          | Reset Password

    tr
      td(style="text-align: left; font-size: 0.9rem; color: #505356; padding-top: 20px;")
        p
          | If the button above doesn’t work, copy and paste this link in your browser:
        p(style="word-break: break-all;")
          a(href=resetLink)= resetLink

    tr
      td(style="text-align: left; font-size: 1rem; padding-top: 40px;")
        | Warm Regards,
        br
        | The Ennovate Lab Team.
