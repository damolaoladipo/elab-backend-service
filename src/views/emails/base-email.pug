doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Ennovate Lab

    // Fonts
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600&family=Bricolage+Grotesque:wght@400;600&display=swap" rel="stylesheet")

    style.
      body {
        margin: 0;
        padding: 0;
        font-family: 'Bricolage Grotesque', sans-serif;
        background: #fff;
      }
      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      }
      .header {
        background-color: #000;
        padding: 20px;
        text-align: center;
      }
      .header img {
        width: 120px;
        max-width: 100%;
      }
      .footer {
        background-color: #000;
        color: #fff;
        text-align: center;
        padding: 30px;
      }
      .footer img {
        height: 24px;
        width: 24px;
        margin: 0 8px;
      }
      .footer p {
        font-size: 12px;
        margin-top: 15px;
      }
      @media only screen and (max-width: 620px) {
        .email-container {
          width: 100% !important;
        }
        .footer {
          padding: 20px;
        }
      }

  body
    table.email-container(align="center" cellpadding="0" cellspacing="0" role="presentation")
      tr
        td
          // HEADER
          table(width="100%" cellpadding="0" cellspacing="0" class="header")
            tr
              td
                img(src="https://elab-web-api.s3.us-east-2.amazonaws.com/events/eLab-logo.svg-a63c2927-93dc-4939-a425-85fcdde28913.svg" alt="Ennovate Lab Logo")

          // CONTENT
          block content
          // FOOTER
          table(width="100%" cellpadding="0" cellspacing="0" class="footer")
            tr
              td
                a(href="https://www.linkedin.com/company/ennovatelab")
                  img(src="https://elab-web-api.s3.us-east-2.amazonaws.com/events/linkedin.svg-91265a95-a70b-4518-aea4-161fabb732b0.svg" alt="LinkedIn")
                a(href="http://facebook.com/Ennovatelab")
                  img(src="https://elab-web-api.s3.us-east-2.amazonaws.com/events/facebook.svg-6d4bf6db-8060-4a16-9f6b-cdea8130c7cf.svg" alt="Facebook")
                a(href="https://www.instagram.com/official_ennovatelab")
                  img(src="https://elab-web-api.s3.us-east-2.amazonaws.com/events/instagram.svg-aabda46c-05b3-4c3a-be0e-927453363e18.svg" alt="Instagram")
                a(href="https://x.com/ennovatelab")
                  img(src="https://elab-web-api.s3.us-east-2.amazonaws.com/events/x.svg-875b7dba-47f3-4f84-86d7-915e22f770b2.svg" alt="X")
                a(href="https://xyoutube.com/@ennovatelab")
                  img(src="https://elab-web-api.s3.us-east-2.amazonaws.com/events/youtube.svg-ec13a206-ff09-4021-a417-ac47813597b7.svg" alt="YouTube")
               

                p
                  | &copy; #{new Date().getFullYear()} Ennovate Lab.
