doctype html
html(lang="en")
	head
		meta(charset="UTF-8")
		meta(http-equiv="X-UA-Compatible" content="IE=edge")
		meta(name="viewport" content="width=device-width, initial-scale=1.0")
		// GOOGLE FONT (INTER)
		link(rel="preconnect" href="https://fonts.googleapis.com")
		link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
		link(href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap" rel="stylesheet")
		title Ennovate Lab
	body(style="padding: 50px auto 50px; font-family: Bricolage Grotesque; background: #fff;")
		table(style="padding: 50px auto 50px; font-family: Bricolage Grotesque; margin: 0 auto 0; background: #fff;")
			tr
				td(style="padding: 50px auto 50px; font-family: Bricolage Grotesque; width: 100%; margin: 0px auto 0px; background: #fff;")
					// HEADER SECTION STARTS
					table(style="height: 120px; background-color: #fff; text-align: center; border-radius: 20px 20px 0 0; width: 600px; padding: 20px 0 15px; margin: 50px auto 0px; ")
						tr
							td
								img(src="https://the-assembly-api-staging.s3.us-east-1.amazonaws.com/general/assembly-logo-full.png" alt="the assembly logo" width="25%")
					// CONTENT SECTION STARTS
					block content
					// CONTENT SECTION ENDS
					// FOOTER SECTION STARTS
					table(style="background:#000; text-align: center; border-radius: 20px; margin: 15px auto 50px; color: #fff; cursor: pointer; width: 100%; padding: 30px 30px; ")
						tr(style="text-align: left; background: transparent; border-radius: 0px 0px 10px 10px; ")
							td
								span
									a(href="https://theassembly.city" style="padding: 3px 3px 3px 0px; border: 0; font-weight: 500; cursor: pointer; margin: 0px auto 40px; text-decoration: none; color: #fff; font-size: 1rem;")
										| &copy; #{new Date().getFullYear()} Ennovate lab.
								br
								span(style="font-size: .7rem; color: #fff;")
									| Transforming underserved communities.
							td(style="text-align: right; padding-top: 3px")
								span
									a(href="https://web.facebook.com/61576880371258/" style="padding: 5px 5px; border: 0; font-weight: 700; cursor: pointer; margin: 0px auto 45px; text-decoration: none; color: #ffffff; ")
										img(src="https://the-assembly-api-staging.s3.us-east-1.amazonaws.com/general/icons/facebook.png" alt="facebook logo icon" width="20rem")
								span
									a(href="https://www.instagram.com/theassemblycity/" style="padding: 5px 5px; border: 0; font-weight: 700; cursor: pointer; margin: 0px auto 45px; text-decoration: none; color: #ffffff; ")
										img(src="https://the-assembly-api-staging.s3.us-east-1.amazonaws.com/general/icons/instagram.png" alt="instagram logo icon" width="20rem")
								span
									a(href="https://www.linkedin.com/company/the-assembly-city/" style="padding: 5px 5px; border: 0; font-weight: 700; cursor: pointer; margin: 0px auto 45px; text-decoration: none; color: #ffffff; ")
								span
									a(href="https://x.com/TheAssemblyCity" style="padding: 5px 5px; border: 0; font-weight: 700; cursor: pointer; margin: 0px auto 45px; text-decoration: none; color: #ffffff; ")
										img(src="https://the-assembly-api-staging.s3.us-east-1.amazonaws.com/general/icons/twitter.png" alt="linkedin logo icon" width="20rem")
						// FOOTER SOCIAL MEDIA LINKS ENDS
					// FOOTER SECTION ENDS
